        },
        "handlers.messageResponse": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "session_id": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "handlers.providerInfo": {
            "type": "object",
            "properties": {
                "available": {
                    "type": "boolean"
                },
                "model": {
                    "type": "string"
                },
