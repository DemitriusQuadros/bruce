                ],
                "tags": [
                    "config"
                ],
                "summary": "Get / update runtime config",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.configEntry"
                            }
                        }
                    }
                }
            },
            "put": {
                "description": "Returns or updates the runtime configuration",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "config"
                ],
                "summary": "Get / update runtime config",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.configEntry"
                            }
                        }
                    }
                }
            }
        },
