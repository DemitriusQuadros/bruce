                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Manage sessions",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.sessionResponse"
